# Target public repository.
GITHUB_OWNER=vercel
GITHUB_REPO=next.js

# Optional for higher rate limits and private/admin operations.
# Required only if you want the wrapper to create/delete repo webhooks.
GITHUB_TOKEN=

# Optional, but strongly recommended before exposing webhook endpoints.
GITHUB_WEBHOOK_SECRET=

# Optional comma-separated allowlist for incoming GitHub webhook events.
# Example: push,pull_request,workflow_run,workflow_job,check_suite
GITHUB_ALLOWED_EVENTS=

# Optional target to fan out verified webhook events.
WEBHOOK_FORWARD_URL=

# Optional bearer token to protect wrapper API calls.
WRAPPER_API_TOKEN=
